{
  "name": "quiz-page",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "description": "《3-6岁儿童学习与发展指南》刷题手册 — Cloudflare Workers + D1 + TypeScript",
  "scripts": {
    "dev": "wrangler dev",
    "dev:kv": "wrangler dev --config wrangler.kv.toml",
    "dev:frontend": "vite webapp",
    "build": "vite build webapp && tsc --noEmit && tsc --noEmit -p webapp",
    "deploy": "wrangler deploy",
    "deploy:kv": "wrangler deploy --config wrangler.kv.toml",
    "test": "tsx scripts/api-test.ts",
    "e2e": "node scripts/e2e-check.js",
    "validate": "python scripts/validate_questions.py"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "tsx": "^4.19.0",
    "typescript": "~5.6.0",
    "vite": "^7.0.0",
    "wrangler": "^4.20.0"
  }
}
